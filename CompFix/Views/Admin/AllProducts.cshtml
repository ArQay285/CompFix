@model IEnumerable<CompFix.Models.Product>
@{
    ViewData["Title"] = "Каталог Товарів";
}
<div class="catalog-container">
    <!-- Шапка сторінки -->
    <div class="catalog-header">
        <h2>Каталог товарів 📦</h2>
    </div>
    <!-- Основна сітка: Ліворуч товари, Праворуч фільтри -->
    <div class="catalog-layout">
        <!-- 1. ЗОНА ТОВАРІВ -->
        <div class="catalog-main">
            @if (!Model.Any())
            {
                <div class="catalog-empty-state">
                    <p>Наразі немає товару, що відповідає обраним фільтрам</p>
                </div>
            }
            else
            {
                <div class="products-grid">
                    @foreach (var product in Model)
                    {
                        <div class="compfix-card">
                            <div class="compfix-card__img-box">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" class="compfix-card__img" />
                                }
                                else
                                {
                                    <div class="compfix-card__no-img">Без фото</div>
                                }
                            </div>
                            
                            <!-- Тіло картки, куди перенесено весь внутрішній контент -->
                            <div class="compfix-card__body">
                                <h6 class="compfix-card__title" title="@product.Name">@product.Name</h6>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="compfix-card__badge mb-0">@(product.Category?.Name ?? "Немає категорії")</span>
        
                                    <!-- Індикатор доступності -->
                                    @if (product.IsAvailable && product.Quantity > 0)
                                    {
                                     <span class="compfix-status-badge compfix-status-badge--available">
                                         ✓ В наявності
                                    </span>
                                 }
                                 else
                                 {
                                       <span class=" compfix-status-badge compfix-status-badge--unavailable">
                                           ✕ Недоступний
                                       </span>
                                 }



                                </div>
                                
                                <!-- Блок з цінами -->  
                                <div class="compfix-card__price-row">
                                    @if(product.Discount > 0)
                                    {   <div class="compfix-card__old-price-box">
                                        <span class="compfix-card__old-price">@product.Price.ToString("N0") ₴</span>
                                        <span class="compfix-card__discount-tag">-@product.Discount%</span>
                                        </div>
                                        <div class="compfix-card__main-price text-purple">@product.DiscountedPrice.ToString("N0") ₴</div>
                                    }
                                    else
                                    {
                                        <div class="compfix-card__main-price">@product.Price.ToString("N0") ₴</div>
                                    }
                                </div>

                                <!-- Мета-інформація: Кількість та Стан -->
                                <div class="compfix-card__info">
                                    <span>Кількість: <strong>@product.Quantity шт.</strong></span>
                                    <span class="compfix-card__condition">
                                        @switch (product.Condition)
                                        {
                                            case CompFix.Models.ItemCondition.New:
                                                <text>Новий</text>
                                                break;
                                            case CompFix.Models.ItemCondition.Used:
                                                <text>Вживаний</text>
                                                break;
                                            case CompFix.Models.ItemCondition.Refurbished:
                                                <text>Відновлений</text>
                                                break;
                                        }
                                    </span>
                                </div>

                                <!-- Кнопки дій адміна -->
                                <div class="compfix-card__buttons">
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="compfix-btn compfix-btn--edit">
                                        Редагувати
                                    </a>
                                    <form asp-action="DeleteAsync" asp-route-id="@product.Id" method="post" style="flex:1" onsubmit="return confirm('Ви дійсно хочете видалити цей товар?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="compfix-btn compfix-btn--delete w-100">
                                            Видалити
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
        </div>

        <!-- 2. ЗОНА ФІЛЬТРІВ (Права частина) -->
        <div class="catalog-sidebar">
            <div class="filter-panel">
                <div class="filter-panel__header">
                <h5>Фільтри</h5>
                <span class="filter-panel__icon">⚡</span>
                </div>
                <form asp-action="AllProducts" method="get" class="filter-panel__form">
                    <!-- Пошук за назвою -->
                    <div class="filter-field">
                       <input type="text" name="search"  value="@ViewBag.CurrentSearch" class="form-control form-control-sm" placeholder="Шукати за назвою..."/>
                    </div>
                    <!-- Вибір категорії -->
                    <div class="filter-field">
                        <label class="filter-label">Категорія</label>
                        <select name="categoryId" asp-items="ViewBag.Categories" class="form-select form-select-sm">
                            <option value="">Оберіть категорію</option>
                        </select>
                        <!-- Сортування -->
                     </div>
                     <div class="filter-field">
                         <label class="filter-label">Сортування</label>
                         <select name="SortBy" class="form-select form-select-sm">
                             <option value=""  selected="@(ViewBag.CurrentSort == null)">Спочатку нові</option>
                             <option value="date_old" selected="@(ViewBag.CurrentSort == "date_old")">Спочатку старі</option>
                             <option value="price_increase" selected="@(ViewBag.CurrentSort == "price_increase")">Від дешевших до дорогих</option>
                             <option value="price_reduc" selected="@(ViewBag.CurrentSort == "price_reduc")">Від дорогих до дешевших</option>
                         </select>
                     </div>
                     <!-- Ціна (від / до) -->
                     <div class="filter-field">
                        <label class="filter-label">Ціна,₴</label>
                        <div class="d-flex gap-2">
                            <input type="number" name="MinPrice" value="@ViewBag.MinPrice" placeholder="від" class="form-control form-control-sm"/>  
                            <input type="number" name="MaxPrice" value="@ViewBag.MaxPrice" placeholder="до" class="form-control form-control-sm"/>  
                        </div>
                     </div>
                     <!-- Стан товару -->
                     <div class="filter-field">
                        <label class="product-form__toggle">
                            <input type="checkbox" name="HasDiscount" value="true" checked="@(ViewBag.HasDiscount == true)"/>
                            <span class="product-form__toggle-slider"></span>
                            <span class="filter-toggle-text">Тільки зі знижкою</span>
                        </label>
                       </div>
                       <div class="filter-field">
                           <label class="filter-label">Стан</label>
                           <select name="condition" class="form-select form-select-sm">
                               <option value="">Обереіть варіант</option>
                               <option value="0" selected="@(ViewBag.CurrentCondition == "0")">Новий</option>
                               <option value="1" selected="@(ViewBag.CurrentCondition =="1")">Б/У (Вживаний)</option>
                               <option value="2" selected="@(ViewBag.CurrentCondition == "2")">Відновлений</option>
                           </select>
                       </div>
                       <!-- Чекбокс: Доступність -->
                       <div class="filter-field">
                           <label class="product-form__toggle">
                            <input type="checkbox" name="IsAvailable" value="true" checked="@(ViewBag.IsAvailable == true)" />
                            <span class="product-form__toggle-slider"></span>
                            <span class="filter-toggle-text">Доступно для замовлення</span>
                        </label>
                       </div>
                       <!-- Кнопки керування -->
                       <div class="filter-buttons mt-3">
                           <button type="submit" class="compfix-btn compfix-btn--submit w-100">Застосувати</button>
                           <a asp-action="AllProducts" class="filter-reset-link w-100 ">Скасувати</a>
                       </div>

                </form>
            </div>

        </div>



    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.querySelector('input[name="search"]');
            
            if (searchInput) {
                let debounceTimer;

                searchInput.addEventListener('input', function () {
                    // Очищаємо таймер, поки  друкуєш
                    clearTimeout(debounceTimer);

                    // Як тільки зробив паузу в 800 мс — відправляємо форму
                    debounceTimer = setTimeout(() => {
                        this.closest('form').submit();
                    }, 800);
                });
            }
        });
    </script>
}
